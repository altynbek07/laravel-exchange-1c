{
    "name": "altynbek07/laravel-exchange-1c",
    "description": "Laravel exchange from 1C",
    "keywords": [
        "laravel",
        "exchange",
        "1c",
        "uploading",
        "synchronization",
        "1с",
        "выгрузка",
        "обмен",
        "синхронизация",
        "предприятие"
    ],
    "homepage": "https://github.com/altynbek07/laravel-exchange-1c",
    "license": "MIT",
    "authors": [
        {
            "name": "Altynbek",
            "email": "altynbek.kazezov.97@gmail.com",
            "homepage": "https://github.com/altynbek07",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "carono/commerceml": "^0.2.8"
    },
    "require-dev": {
        "laravel/pint": "^1.19",
        "orchestra/testbench": "^9.9",
        "pestphp/pest": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "Altynbek07\\Exchange1C\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Altynbek07\\Exchange1C\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Altynbek07\\Exchange1C\\Exchange1CServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
